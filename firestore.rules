rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A due's document ID is its share code.
    match /dues/{code} {
      // Students open a due by code without signing in.
      allow get: if true;
      // Treasurers can only list their own dues.
      allow list: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.amount is int
                    && request.resource.data.amount >= 100
                    && request.resource.data.collectedTotal == 0
                    && request.resource.data.paidCount == 0;
      // Totals change only through the backend.
      allow update, delete: if false;
    }

    // Payment documents are written only by the backend (admin SDK bypasses rules).
    match /payments/{reference} {
      // A student watches their own payment by its unguessable reference.
      allow get: if true;
      allow list: if request.auth != null
                  && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
  }
}
