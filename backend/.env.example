# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Never put them in the Flutter app or commit real values.

# From your Paga Business account -> API keys
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=

# Sandbox: https://beta-collect.paga.com   Live: https://collect.paga.com
PAGA_BASE_URL=https://beta-collect.paga.com

# Your deployed backend URL, no trailing slash, e.g. https://duespay.vercel.app
PUBLIC_BASE_URL=

# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Paste the whole JSON file base64-encoded:  base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=

# Who pays Paga's collection fee. The two must follow Paga's rule for fee shares.
PAYER_FEE_SHARE=1.0
PAYEE_FEE_SHARE=0.0

# Minutes before an unpaid account number expires
PAYMENT_EXPIRY_MINUTES=30
